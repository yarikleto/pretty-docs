---
/**
 * BlockHeader — SVG diagram: the 3-byte block header format.
 *
 * Visualizes the structure defined in RFC 959 Section 3.4.2 (Block Mode):
 *   Byte 1:   Descriptor (8 bits) — flags indicating EOR, EOF, errors, restart
 *   Bytes 2-3: Byte Count (16 bits) — length of the following data block
 *
 * The descriptor byte uses individual bits as flags. The byte count gives the
 * total number of data bytes in the block, allowing the receiver to know
 * exactly where the next header begins.
 *
 * Dark mode adaptation uses CSS classes defined in custom.css section 8:
 *   .axis-card, .axis-card-text, .axis-card-sub
 * Plus scoped styles below for the container and separator line.
 */
---

<div class="diagram-wrapper block-header">
  <p class="block-header-label">Block Header Format</p>
  <svg viewBox="0 0 600 130" class="block-header-svg" xmlns="http://www.w3.org/2000/svg">
    {/* Bit position markers above the boxes */}
    <text class="axis-card-sub" x="50" y="14" font-size="10" fill="#adb5bd" text-anchor="middle">0</text>
    <text class="axis-card-sub" x="200" y="14" font-size="10" fill="#adb5bd" text-anchor="middle">8</text>
    <text class="axis-card-sub" x="500" y="14" font-size="10" fill="#adb5bd" text-anchor="middle">24</text>

    {/* Descriptor box: 8 bits (150px wide) */}
    <rect class="axis-card" x="50" y="20" width="150" height="60" rx="4"
          fill="#f0f4ff" stroke="#4c6ef5" stroke-width="1.5"/>
    <text class="axis-card-text" x="125" y="47" font-size="13" font-weight="600"
          fill="#212529" text-anchor="middle">Descriptor</text>
    <text class="axis-card-sub" x="125" y="65" font-size="11"
          fill="#868e96" text-anchor="middle">8 bits</text>

    {/* Byte Count box: 16 bits (300px wide, proportional to bit width) */}
    <rect class="axis-card" x="200" y="20" width="300" height="60" rx="4"
          fill="#f0f4ff" stroke="#4c6ef5" stroke-width="1.5"/>
    <text class="axis-card-text" x="350" y="47" font-size="13" font-weight="600"
          fill="#212529" text-anchor="middle">Byte Count</text>
    <text class="axis-card-sub" x="350" y="65" font-size="11"
          fill="#868e96" text-anchor="middle">16 bits</text>

    {/* Dashed separator line */}
    <line class="block-header-separator" x1="50" y1="90" x2="500" y2="90"
          stroke="#dee2e6" stroke-width="1" stroke-dasharray="4,3"/>

    {/* Caption below the separator */}
    <text class="axis-card-sub" x="275" y="110" font-size="11"
          fill="#868e96" text-anchor="middle">3-byte header precedes each data block</text>
  </svg>
</div>

<style>
  /* Container: bg-surface-50, rounded-2xl, p-6 per design spec section 2.8 */
  .diagram-wrapper.block-header {
    background-color: #fafbfc;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .block-header-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #ced4da;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .block-header-svg {
    width: 100%;
    max-width: 32rem;
    margin: 0 auto;
    display: block;
  }

  .block-header-svg text {
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Dark mode: container background */
  :root[data-theme='dark'] .diagram-wrapper.block-header {
    background-color: #1f2133;
  }

  /* Dark mode: label text */
  :root[data-theme='dark'] .block-header-label {
    color: rgba(200, 202, 216, 0.5);
  }

  /* Dark mode: card fill override for the blue-tinted boxes.
     The .axis-card class in custom.css handles fill:#252740,
     but we also need to adjust the stroke for block header cards. */
  :root[data-theme='dark'] .block-header-svg .axis-card {
    stroke: #2e3150;
  }

  /* Dark mode: separator line */
  :root[data-theme='dark'] .block-header-separator {
    stroke: #2e3150;
  }
</style>
