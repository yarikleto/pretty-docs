---
/*
  LandingFooter.astro — Footer for the landing page.

  Renders the Pretty Docs logo, license information (CC BY-SA for content,
  MIT for code), and links to GitHub and the contribution guide. Compact
  single-row layout with a top border separator.

  No props — all content is static.
*/
---

<footer class="landing-footer">
  <div class="landing-footer-inner">
    <!-- Left: logo + license -->
    <div class="landing-footer-info">
      <div class="landing-footer-logo">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="2" width="10" height="12" rx="1.5" stroke="white" stroke-width="1.5" />
        </svg>
      </div>
      <span>Pretty Docs &mdash; CC BY-SA content, MIT code</span>
    </div>

    <!-- Right: links -->
    <nav class="landing-footer-links" aria-label="Footer">
      <a
        href="https://github.com/YaroslavPakhaliuk/pretty-docs"
        target="_blank"
        rel="noopener noreferrer"
        class="landing-footer-link"
      >
        GitHub
      </a>
      <a href={`${import.meta.env.BASE_URL}/contributing/write-an-article/`} class="landing-footer-link">
        Contribute
      </a>
    </nav>
  </div>
</footer>

<style>
  /* -------------------------------------------
     Landing Footer — compact bar with logo,
     license info, and navigation links
     ------------------------------------------- */
  .landing-footer {
    border-top: 1px solid var(--surface-100);
    background: var(--surface-50);
  }

  .landing-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* --- Left side: logo + license text --- */
  .landing-footer-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--surface-500);
  }

  .landing-footer-logo {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--accent);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* --- Right side: links --- */
  .landing-footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .landing-footer-link {
    font-size: 0.875rem;
    color: #ced4da;
    transition: color 0.15s ease;
  }

  .landing-footer-link:hover {
    color: var(--surface-600);
  }

  :root[data-theme='dark'] .landing-footer-link {
    color: rgba(200, 202, 216, 0.6);
  }

  :root[data-theme='dark'] .landing-footer-link:hover {
    color: #e4e6f0;
  }
</style>
