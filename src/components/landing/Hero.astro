---
/*
  Hero.astro — Landing page hero section.

  Displays the headline with accent-colored second line, subtitle paragraph,
  and two CTA buttons (primary "Browse articles" and secondary "View on GitHub").
  Uses a diagonal gradient background that adapts to light/dark mode via the
  data-theme attribute set by Landing.astro's render-blocking script.

  Tokens referenced:
    --surface-900, --surface-600, --surface-700, --surface-300, --surface-50
    --brand-600, --brand-700, --brand-400, --accent
    --dark-border, --dark-surface, --dark-text
  Some of these are added to Landing.astro's global tokens by this task.
*/
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-headline">
        Old docs are ugly.<br />
        <span class="hero-accent">These aren't.</span>
      </h1>
      <p class="hero-subtitle">
        Pretty Docs rewrites RFCs, man pages, and technical standards into
        beautiful, understandable articles. Open source. Community-driven.
        Always cites the original.
      </p>
      <button class="hero-search" aria-label="Search documentation" type="button">
        <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z"/>
        </svg>
        <span class="hero-search-placeholder">Search documentation...</span>
        <kbd class="hero-search-kbd" style="display: none;">
          <kbd class="hero-search-platform-key">Ctrl</kbd><kbd>K</kbd>
        </kbd>
      </button>
      <div class="hero-actions">
        <a href={`${import.meta.env.BASE_URL}/w3.org/Protocols/rfc959/`} class="btn btn-primary">
          Browse articles
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 4l4 4-4 4" />
          </svg>
        </a>
        <a
          href="https://github.com/yarikleto/pretty-docs"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero search bar: detect platform for shortcut badge, open search dialog on click
  (() => {
    const heroBtn = document.querySelector('.hero-search');
    if (!heroBtn) return;

    const kbd = heroBtn.querySelector('.hero-search-kbd');
    const platformKey = heroBtn.querySelector('.hero-search-platform-key');
    if (kbd && platformKey) {
      if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        platformKey.textContent = '\u2318';
      }
      kbd.style.display = '';
    }

    heroBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Dispatch custom event that Search component listens for
      window.dispatchEvent(new CustomEvent('open-search'));
    });
  })();
</script>

<style>
  /* --- Hero gradient background --- */
  .hero {
    background: linear-gradient(135deg, #f0f4ff 0%, #ffffff 50%, #f0f4ff 100%);
  }

  :root[data-theme='dark'] .hero {
    background: linear-gradient(135deg, #1f2133 0%, #1a1b26 50%, #1f2133 100%);
  }

  /* --- Layout --- */
  .hero-container {
    max-width: 72rem; /* max-w-6xl = 1152px */
    margin-inline: auto;
    padding: 96px 24px 80px; /* pt-24 pb-20 px-6 */
  }

  .hero-content {
    max-width: 42rem; /* max-w-2xl = 672px */
  }

  /* --- Headline --- */
  .hero-headline {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--surface-900);
    margin: 0;
  }

  @media (max-width: 480px) {
    .hero-headline {
      font-size: 2.25rem;
    }
  }

  .hero-accent {
    color: var(--brand-600);
  }

  :root[data-theme='dark'] .hero-accent {
    color: var(--brand-400);
  }

  /* --- Subtitle --- */
  .hero-subtitle {
    margin-top: 24px;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.625;
    color: var(--surface-600);
    max-width: 32rem; /* max-w-lg = 512px */
  }

  /* --- Button group --- */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  /* --- Shared button styles --- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-sans);
    line-height: 1.5;
    cursor: pointer;
    border: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  /* --- Primary button --- */
  .btn-primary {
    background: var(--brand-600);
    color: #ffffff;
    box-shadow: 0 1px 2px rgba(76, 110, 245, 0.2);
  }

  .btn-primary:hover {
    background: #4263eb; /* brand-700 */
  }

  :root[data-theme='dark'] .btn-primary {
    background: var(--brand-400);
    color: #1a1b26;
    box-shadow: none;
  }

  :root[data-theme='dark'] .btn-primary:hover {
    background: #91a7ff; /* brand-300, slightly lighter */
  }

  /* --- Secondary button --- */
  .btn-secondary {
    background: transparent;
    color: var(--surface-700);
    border: 1px solid #dee2e6; /* surface-300 */
  }

  .btn-secondary:hover {
    border-color: #ced4da; /* surface-400 */
    background: var(--surface-50);
  }

  :root[data-theme='dark'] .btn-secondary {
    color: var(--text-body);
    border-color: #2e3150; /* dark-border */
  }

  :root[data-theme='dark'] .btn-secondary:hover {
    border-color: rgba(200, 202, 216, 0.3);
    background: #1f2133; /* dark-surface */
  }

  /* --- Hero search bar --- */
  .hero-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 32rem;
    height: 52px;
    margin-top: 32px;
    padding: 0 16px;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    background: #ffffff;
    cursor: pointer;
    font-family: 'Inter', system-ui, sans-serif;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .hero-search:hover {
    border-color: #dee2e6;
  }

  .hero-search:focus-visible {
    outline: 2px solid var(--brand-600);
    outline-offset: 2px;
  }

  :root[data-theme='dark'] .hero-search {
    background: #1f2133;
    border-color: #2e3150;
  }

  :root[data-theme='dark'] .hero-search:hover {
    border-color: #3e4170;
  }

  :root[data-theme='dark'] .hero-search:focus-visible {
    outline-color: var(--brand-400);
  }

  .hero-search-icon {
    flex-shrink: 0;
    color: #868e96;
  }

  :root[data-theme='dark'] .hero-search-icon {
    color: #6b6e82;
  }

  .hero-search-placeholder {
    flex: 1;
    text-align: left;
    font-size: 0.9375rem;
    color: #adb5bd;
    pointer-events: none;
  }

  :root[data-theme='dark'] .hero-search-placeholder {
    color: #6b6e82;
  }

  .hero-search-kbd {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 4px 8px;
    border-radius: 6px;
    background: #f1f3f5;
    font-size: 0.75rem;
    color: #868e96;
    pointer-events: none;
  }

  :root[data-theme='dark'] .hero-search-kbd {
    background: #252740;
    color: #6b6e82;
  }

  .hero-search-kbd kbd {
    font-family: 'Inter', system-ui, sans-serif;
  }
</style>
