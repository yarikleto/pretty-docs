---
/*
  LandingNav.astro — Sticky navigation bar for the landing page.

  Renders logo, page links, GitHub icon, and dark mode toggle.
  The dark mode toggle reads/writes Starlight's `starlight-theme`
  localStorage key and toggles the `data-theme` attribute on <html>,
  keeping the landing page in sync with Starlight article pages.

  No props — all content is static.
*/
---

<nav class="landing-nav">
  <div class="landing-nav-inner">
    <!-- Logo -->
    <a href={import.meta.env.BASE_URL} class="landing-nav-logo">
      <div class="landing-nav-logo-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="2" width="10" height="12" rx="1.5" stroke="white" stroke-width="1.5" />
          <line x1="5.5" y1="5.5" x2="10.5" y2="5.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="8" x2="10.5" y2="8" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="10.5" x2="8.5" y2="10.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
        </svg>
      </div>
      <span class="landing-nav-logo-text">Pretty Docs</span>
    </a>

    <!-- Right side: links + GitHub + theme toggle -->
    <div class="landing-nav-actions">
      <a href={`${import.meta.env.BASE_URL}/networking/ftp-data-transfer/`} class="landing-nav-link">Articles</a>
      <a href={`${import.meta.env.BASE_URL}/contributing/write-an-article/`} class="landing-nav-link">Contribute</a>
      <a
        href="https://github.com/yarikleto/pretty-docs"
        target="_blank"
        rel="noopener noreferrer"
        class="landing-nav-link landing-nav-github"
        aria-label="GitHub repository"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <button
        type="button"
        class="landing-nav-theme-toggle"
        aria-label="Toggle dark mode"
      >
        <!-- Moon icon — shown in light mode (click to switch to dark) -->
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
        <!-- Sun icon — shown in dark mode (click to switch to light) -->
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="10" cy="10" r="3" />
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.93 4.93l1.41 1.41M13.66 13.66l1.41 1.41M4.93 15.07l1.41-1.41M13.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Dark mode toggle — syncs with Starlight's localStorage key.
  // Uses event delegation on the nav so this works even if the DOM
  // is swapped by Astro's View Transitions.
  function initThemeToggle() {
    const button = document.querySelector('.landing-nav-theme-toggle');
    if (!button) return;

    button.addEventListener('click', () => {
      const html = document.documentElement;
      const currentTheme = html.dataset.theme;
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

      html.dataset.theme = nextTheme;
      localStorage.setItem('starlight-theme', nextTheme);
    });
  }

  // Run on initial load
  initThemeToggle();

  // Re-run after Astro View Transitions (if ever added)
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>

<style>
  /* -------------------------------------------
     Landing Nav — sticky bar with backdrop blur
     ------------------------------------------- */
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    border-bottom: 1px solid var(--surface-200);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :root[data-theme='dark'] .landing-nav {
    border-bottom-color: #2e3150;
    background: rgba(26, 27, 38, 0.8);
  }

  .landing-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* --- Logo --- */
  .landing-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .landing-nav-logo-icon {
    width: 28px;
    height: 28px;
    background: var(--brand-600);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .landing-nav-logo-text {
    font-weight: 600;
    color: var(--surface-900);
    letter-spacing: -0.025em;
  }

  /* --- Right actions --- */
  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* --- Links --- */
  .landing-nav-link {
    font-size: 0.875rem;
    color: var(--surface-600);
    transition: color 0.15s ease;
  }

  .landing-nav-link:hover {
    color: var(--surface-900);
  }

  .landing-nav-github {
    display: flex;
    align-items: center;
  }

  /* --- Theme toggle button --- */
  .landing-nav-theme-toggle {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--surface-200);
    background: transparent;
    color: var(--surface-500);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    flex-shrink: 0;
    font-family: inherit;
  }

  .landing-nav-theme-toggle:hover {
    border-color: #ced4da;
    color: var(--surface-700);
    background: #f8f9fa;
  }

  :root[data-theme='dark'] .landing-nav-theme-toggle {
    border-color: #2e3150;
    background: #252740;
    color: #6b6e82;
  }

  :root[data-theme='dark'] .landing-nav-theme-toggle:hover {
    border-color: #3e4170;
    color: #c8cad8;
    background: #2e3150;
  }

  /* Icon visibility: light mode shows moon, dark mode shows sun */
  .icon-sun {
    display: none;
  }

  .icon-moon {
    display: block;
  }

  :root[data-theme='dark'] .icon-sun {
    display: block;
  }

  :root[data-theme='dark'] .icon-moon {
    display: none;
  }
</style>
