---
/*
  LandingNav.astro — Sticky navigation bar for the landing page.

  Renders logo, page links, search (shared component), GitHub icon,
  and theme select. The theme select reads/writes Starlight's
  `starlight-theme` localStorage key.
*/
import Search from '../Search.astro';
---

<nav class="landing-nav">
  <div class="landing-nav-inner">
    <!-- Logo -->
    <a href={import.meta.env.BASE_URL} class="landing-nav-logo">
      <div class="landing-nav-logo-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="2" width="10" height="12" rx="1.5" stroke="white" stroke-width="1.5" />
          <line x1="5.5" y1="5.5" x2="10.5" y2="5.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="8" x2="10.5" y2="8" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="10.5" x2="8.5" y2="10.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
        </svg>
      </div>
      <span class="landing-nav-logo-text">Pretty Docs</span>
    </a>

    <!-- Right side: links + GitHub + theme toggle -->
    <!-- Search component is hidden in nav (hero has the visible search bar) but still renders the dialog + Pagefind UI -->
    <div class="landing-nav-search-hidden"><Search /></div>
    <div class="landing-nav-actions">
      <a href={`${import.meta.env.BASE_URL}/w3.org/Protocols/rfc959/`} class="landing-nav-link">Articles</a>
      <a href={`${import.meta.env.BASE_URL}/contributing/write-an-article/`} class="landing-nav-link">Contribute</a>
      <a
        href="https://github.com/yarikleto/pretty-docs"
        target="_blank"
        rel="noopener noreferrer"
        class="landing-nav-link landing-nav-github"
        aria-label="GitHub repository"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <label class="landing-nav-theme-select">
        <svg class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/>
        </svg>
        <select aria-label="Theme">
          <option value="dark">Dark</option>
          <option value="light">Light</option>
          <option value="auto" selected>Auto</option>
        </select>
        <svg class="theme-caret" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/>
        </svg>
      </label>
    </div>
  </div>
</nav>

<script>
  // Theme select — syncs with Starlight's localStorage key.
  // Supports dark / light / auto (system preference).
  function getPreferredColorScheme() {
    return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function applyTheme(theme) {
    const resolved = theme === 'auto' ? getPreferredColorScheme() : theme;
    document.documentElement.dataset.theme = resolved;
    localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
  }

  function initThemeSelect() {
    const select = document.querySelector('.landing-nav-theme-select select');
    if (!select || select.dataset.init) return;
    select.dataset.init = '1';

    // Set initial value from localStorage
    const stored = localStorage.getItem('starlight-theme');
    if (stored === 'dark' || stored === 'light') {
      select.value = stored;
    } else {
      select.value = 'auto';
    }

    select.addEventListener('change', (e) => {
      applyTheme(e.target.value);
    });

    // React to system theme changes when in auto mode
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      if (select.value === 'auto') applyTheme('auto');
    });
  }

  initThemeSelect();
  document.addEventListener('astro:after-swap', initThemeSelect);
</script>

<style>
  /* -------------------------------------------
     Landing Nav — sticky bar with backdrop blur
     ------------------------------------------- */
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    border-bottom: 1px solid var(--surface-200);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :root[data-theme='dark'] .landing-nav {
    border-bottom-color: #2e3150;
    background: rgba(26, 27, 38, 0.8);
  }

  .landing-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* --- Logo --- */
  .landing-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .landing-nav-logo-icon {
    width: 28px;
    height: 28px;
    background: var(--brand-600);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .landing-nav-logo-text {
    font-weight: 600;
    color: var(--surface-900);
    letter-spacing: -0.025em;
  }

  /* --- Hidden search (keeps dialog + Pagefind, hides trigger button) --- */
  .landing-nav-search-hidden {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }
  .landing-nav-search-hidden :global(site-search button[data-open-modal]) {
    display: none;
  }
  /* Allow the dialog itself to be interactive */
  .landing-nav-search-hidden :global(site-search dialog) {
    pointer-events: auto;
  }

  /* --- Right actions --- */
  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* --- Links --- */
  .landing-nav-link {
    font-size: 0.875rem;
    color: var(--surface-600);
    transition: color 0.15s ease;
  }

  .landing-nav-link:hover {
    color: var(--surface-900);
  }

  .landing-nav-github {
    display: flex;
    align-items: center;
  }

  /* --- Theme select dropdown --- */
  .landing-nav-theme-select {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    position: relative;
    color: var(--surface-600);
    cursor: pointer;
    font-size: 0.875rem;
  }

  .landing-nav-theme-select select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    padding-right: 0.25rem;
  }

  .landing-nav-theme-select select:focus {
    outline: none;
  }

  .theme-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .theme-caret {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .landing-nav-theme-select:hover {
    color: var(--surface-900);
  }

  :root[data-theme='dark'] .landing-nav-theme-select {
    color: #6b6e82;
  }

  :root[data-theme='dark'] .landing-nav-theme-select:hover {
    color: #c8cad8;
  }

  :root[data-theme='dark'] .landing-nav-theme-select select option {
    background: #1f2133;
    color: #c8cad8;
  }
</style>
