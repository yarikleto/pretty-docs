---
/*
  LandingNav.astro — Sticky navigation bar for the landing page.

  Renders logo, page links, GitHub icon, and dark mode toggle.
  The dark mode toggle reads/writes Starlight's `starlight-theme`
  localStorage key and toggles the `data-theme` attribute on <html>,
  keeping the landing page in sync with Starlight article pages.

  No props — all content is static.
*/
---

<nav class="landing-nav">
  <div class="landing-nav-inner">
    <!-- Logo -->
    <a href={import.meta.env.BASE_URL} class="landing-nav-logo">
      <div class="landing-nav-logo-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="2" width="10" height="12" rx="1.5" stroke="white" stroke-width="1.5" />
          <line x1="5.5" y1="5.5" x2="10.5" y2="5.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="8" x2="10.5" y2="8" stroke="white" stroke-width="1.2" stroke-linecap="round" />
          <line x1="5.5" y1="10.5" x2="8.5" y2="10.5" stroke="white" stroke-width="1.2" stroke-linecap="round" />
        </svg>
      </div>
      <span class="landing-nav-logo-text">Pretty Docs</span>
    </a>

    <!-- Right side: search + links + GitHub + theme toggle -->
    <div class="landing-nav-actions">
      <button class="landing-search-btn" type="button" aria-label="Search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <span class="landing-search-text">Search</span>
        <kbd class="landing-search-kbd">
          <kbd>⌘</kbd><kbd>K</kbd>
        </kbd>
      </button>
      <a href={`${import.meta.env.BASE_URL}/networking/ftp-data-transfer/`} class="landing-nav-link">Articles</a>
      <a href={`${import.meta.env.BASE_URL}/contributing/write-an-article/`} class="landing-nav-link">Contribute</a>
      <a
        href="https://github.com/yarikleto/pretty-docs"
        target="_blank"
        rel="noopener noreferrer"
        class="landing-nav-link landing-nav-github"
        aria-label="GitHub repository"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <label class="landing-nav-theme-select">
        <svg class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/>
        </svg>
        <select aria-label="Theme">
          <option value="dark">Dark</option>
          <option value="light">Light</option>
          <option value="auto" selected>Auto</option>
        </select>
        <svg class="theme-caret" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/>
        </svg>
      </label>
    </div>
  </div>
</nav>

<!-- Search modal -->
<dialog class="landing-search-dialog" aria-label="Search">
  <div class="landing-search-dialog-frame">
    <div id="landing-search"></div>
    <button class="landing-search-close" type="button">Cancel</button>
  </div>
</dialog>

<script>
  // Theme select — syncs with Starlight's localStorage key.
  // Supports dark / light / auto (system preference).
  function getPreferredColorScheme() {
    return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function applyTheme(theme) {
    const resolved = theme === 'auto' ? getPreferredColorScheme() : theme;
    document.documentElement.dataset.theme = resolved;
    localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
  }

  function initThemeSelect() {
    const select = document.querySelector('.landing-nav-theme-select select');
    if (!select || select.dataset.init) return;
    select.dataset.init = '1';

    // Set initial value from localStorage
    const stored = localStorage.getItem('starlight-theme');
    if (stored === 'dark' || stored === 'light') {
      select.value = stored;
    } else {
      select.value = 'auto';
    }

    select.addEventListener('change', (e) => {
      applyTheme(e.target.value);
    });

    // React to system theme changes when in auto mode
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      if (select.value === 'auto') applyTheme('auto');
    });
  }

  initThemeSelect();
  document.addEventListener('astro:after-swap', initThemeSelect);

  // --- Search modal with Pagefind ---
  const BASE = document.querySelector('meta[name="base-url"]')?.content || '';

  let pagefindLoaded = false;
  const dialog = document.querySelector('.landing-search-dialog');
  const searchBtn = document.querySelector('.landing-search-btn');
  const closeBtn = document.querySelector('.landing-search-close');

  async function openSearch() {
    if (!dialog) return;
    dialog.showModal();
    document.body.style.overflow = 'hidden';

    if (!pagefindLoaded) {
      pagefindLoaded = true;
      // Load Pagefind UI dynamically
      const base = `${BASE}/pagefind/`;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = base + 'pagefind-ui.css';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = base + 'pagefind-ui.js';
      script.onload = () => {
        new PagefindUI({
          element: '#landing-search',
          showSubResults: true,
          bundlePath: base,
          baseUrl: BASE + '/',
        });
        // Focus the input
        setTimeout(() => {
          dialog.querySelector('input')?.focus();
        }, 100);
      };
      document.head.appendChild(script);
    } else {
      setTimeout(() => dialog.querySelector('input')?.focus(), 50);
    }
  }

  function closeSearch() {
    if (!dialog) return;
    dialog.close();
    document.body.style.overflow = '';
  }

  searchBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeSearch();
  });

  // Cmd+K / Ctrl+K shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (dialog?.open) closeSearch();
      else openSearch();
    }
    if (e.key === 'Escape' && dialog?.open) closeSearch();
  });
</script>

<style>
  /* -------------------------------------------
     Landing Nav — sticky bar with backdrop blur
     ------------------------------------------- */
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    border-bottom: 1px solid var(--surface-200);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :root[data-theme='dark'] .landing-nav {
    border-bottom-color: #2e3150;
    background: rgba(26, 27, 38, 0.8);
  }

  .landing-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* --- Logo --- */
  .landing-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .landing-nav-logo-icon {
    width: 28px;
    height: 28px;
    background: var(--brand-600);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .landing-nav-logo-text {
    font-weight: 600;
    color: var(--surface-900);
    letter-spacing: -0.025em;
  }

  /* --- Right actions --- */
  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* --- Links --- */
  .landing-nav-link {
    font-size: 0.875rem;
    color: var(--surface-600);
    transition: color 0.15s ease;
  }

  .landing-nav-link:hover {
    color: var(--surface-900);
  }

  .landing-nav-github {
    display: flex;
    align-items: center;
  }

  /* --- Search button --- */
  .landing-search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--surface-200);
    border-radius: 8px;
    background: transparent;
    color: var(--surface-400);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .landing-search-btn:hover {
    border-color: var(--surface-300, #dee2e6);
    color: var(--surface-600);
  }

  .landing-search-text {
    color: inherit;
  }

  .landing-search-kbd {
    display: none;
    font-family: inherit;
    font-size: 0.6875rem;
    gap: 2px;
    color: var(--surface-300, #dee2e6);
  }

  .landing-search-kbd kbd {
    font-family: inherit;
    padding: 1px 4px;
    border: 1px solid var(--surface-200);
    border-radius: 4px;
    font-size: 0.625rem;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .landing-search-kbd {
      display: inline-flex;
    }
    .landing-search-btn {
      min-width: 180px;
    }
  }

  :root[data-theme='dark'] .landing-search-btn {
    border-color: #2e3150;
    color: #6b6e82;
  }

  :root[data-theme='dark'] .landing-search-btn:hover {
    border-color: #3e4170;
    color: #8b8ea0;
  }

  :root[data-theme='dark'] .landing-search-kbd kbd {
    border-color: #2e3150;
  }

  /* --- Search dialog --- */
  .landing-search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    z-index: 100;
  }

  .landing-search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }

  @media (min-width: 50rem) {
    .landing-search-dialog {
      margin: 4rem auto auto;
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      max-height: calc(100% - 8rem);
      border-radius: 12px;
      overflow: hidden;
    }
  }

  .landing-search-dialog-frame {
    background: #fff;
    border: 1px solid var(--surface-200);
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    padding: 1rem;
    overflow: auto;
    max-height: calc(100vh - 8rem);
  }

  :root[data-theme='dark'] .landing-search-dialog-frame {
    background: #1a1b26;
    border-color: #2e3150;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .landing-search-close {
    display: block;
    margin-top: 0.75rem;
    width: 100%;
    padding: 0.5rem;
    background: transparent;
    border: 1px solid var(--surface-200);
    border-radius: 8px;
    color: var(--surface-500);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  :root[data-theme='dark'] .landing-search-close {
    border-color: #2e3150;
    color: #6b6e82;
  }

  @media (min-width: 50rem) {
    .landing-search-close {
      display: none;
    }
  }

  /* --- Theme select dropdown --- */
  .landing-nav-theme-select {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    position: relative;
    color: var(--surface-600);
    cursor: pointer;
    font-size: 0.875rem;
  }

  .landing-nav-theme-select select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    padding-right: 0.25rem;
  }

  .landing-nav-theme-select select:focus {
    outline: none;
  }

  .theme-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .theme-caret {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .landing-nav-theme-select:hover {
    color: var(--surface-900);
  }

  :root[data-theme='dark'] .landing-nav-theme-select {
    color: #6b6e82;
  }

  :root[data-theme='dark'] .landing-nav-theme-select:hover {
    color: #c8cad8;
  }

  :root[data-theme='dark'] .landing-nav-theme-select select option {
    background: #1f2133;
    color: #c8cad8;
  }
</style>
