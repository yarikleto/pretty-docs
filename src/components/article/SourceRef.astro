---
/**
 * SourceRef — Inline source citation with left border.
 *
 * Used after diagrams and significant claims to attribute the source RFC section.
 * Renders as a small left-bordered line with "RFC 959, Section {section}" and an
 * optional quoted excerpt. Minimal version — will be polished in TASK-015.
 *
 * Props:
 *   section  — RFC section number, e.g. "3.1.1"
 *   quote    — optional quoted text from the RFC
 */

interface Props {
  section: string;
  quote?: string;
}

const { section, quote } = Astro.props;
---

<p class="source-ref">
  RFC 959, Section {section}{quote && <> &mdash; "{quote}"</>}
</p>

<style>
  .source-ref {
    font-size: 0.75rem;
    color: #868e96;
    border-left: 2px solid #dee2e6;
    padding-left: 0.75rem;
    margin-top: 1rem;
    margin-bottom: 0;
    line-height: 1.625;
  }

  :root[data-theme='dark'] .source-ref {
    border-left-color: #2e3150;
    color: #6b6e82;
  }
</style>
