---
/**
 * SourceCard — End-of-article source and further reading card.
 *
 * Displays a bordered card with a document icon, title, description, and
 * external links. Used at the bottom of each article to link back to the
 * original specification or related resources.
 *
 * Props:
 *   title       — source document title, e.g. "RFC 959 — File Transfer Protocol"
 *   description — brief description of the source and scope covered
 *   links       — array of { label, href } for external resource links
 */

interface Props {
  title: string;
  description: string;
  links: { label: string; href: string }[];
}

const { title, description, links } = Astro.props;
---

<div class="source-card">
  <div class="source-card-layout">
    <div class="source-card-icon">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <rect x="3" y="2" width="14" height="16" rx="2" />
        <path d="M7 6h6M7 9h6M7 12h4" />
      </svg>
    </div>
    <div>
      <h3 class="source-card-title" set:html={title} />
      <p class="source-card-description">{description}</p>
      {links.length > 0 && (
        <div class="source-card-links">
          {links.map((link, i) => (
            <>
              {i > 0 && <span class="source-card-separator">|</span>}
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="source-card-link">
                {link.label}
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 9v4H3V4h4M8 8l5-5M10 3h3v3" />
                </svg>
              </a>
            </>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .source-card {
    border-radius: 12px;
    border: 1px solid #e9ecef;
    padding: 1.5rem;
  }

  .source-card-layout {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .source-card-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: #f1f3f5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #adb5bd;
  }

  .source-card-title {
    font-weight: 600;
    font-size: 1rem;
    color: #212529;
    margin: 0;
    line-height: 1.4;
  }

  .source-card-description {
    font-size: 0.875rem;
    color: #adb5bd;
    margin: 0.25rem 0 0;
    line-height: 1.625;
  }

  .source-card-links {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .source-card-link {
    font-size: 0.875rem;
    color: #4c6ef5;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 200ms ease-out;
  }

  .source-card-link:hover {
    color: #4263eb;
  }

  .source-card-separator {
    color: #dee2e6;
  }

  /* Dark mode */
  :root[data-theme='dark'] .source-card {
    border-color: #2e3150;
  }

  :root[data-theme='dark'] .source-card-icon {
    background: #252740;
    color: rgba(200, 202, 216, 0.5);
  }

  :root[data-theme='dark'] .source-card-title {
    color: #e4e6f0;
  }

  :root[data-theme='dark'] .source-card-description {
    color: #c8cad8;
  }

  :root[data-theme='dark'] .source-card-link {
    color: #748ffc;
  }

  :root[data-theme='dark'] .source-card-link:hover {
    color: #91a7ff;
  }

  :root[data-theme='dark'] .source-card-separator {
    color: #2e3150;
  }
</style>
