---
/*
  Landing page — Pretty Docs home.

  Standalone Astro page outside Starlight. Uses the Landing layout for HTML
  shell, fonts, and dark mode sync. Renders the LandingNav followed by the
  Hero section; subsequent tasks will add BeforeAfter, Features, Cta, and
  Footer components.
*/

import Landing from '../layouts/Landing.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import Hero from '../components/landing/Hero.astro';
import BeforeAfter from '../components/landing/BeforeAfter.astro';
import Features from '../components/landing/Features.astro';
import Cta from '../components/landing/Cta.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---

<Landing
  title="Pretty Docs — Beautiful, readable documentation"
  description="Beautiful, readable documentation for protocols, standards, and C libraries."
>
  <LandingNav />
  <Hero />
  <BeforeAfter />
  <Features />
  <Cta />
  <LandingFooter />
</Landing>
